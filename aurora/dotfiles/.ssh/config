# Machine-specific overrides can remain outside this repository.
Include ~/.ssh/config.local

Host herdr-server herdr
    HostName 192.168.53.95
    User austinstowe
    IdentityFile ~/.ssh/id_ed25519
    IdentityAgent /run/user/%i/ssh-agent.socket
    IdentitiesOnly yes
    BatchMode yes
    ForwardAgent no
    ServerAliveInterval 30
    ServerAliveCountMax 3
